##############################################################################
# BrSD — perfil de referência: 8 kHz, sem detecção de atividade vocal.
#
# Reproduz a configuração do experimento original. As gravações têm 2 a 3
# minutos, e sem VAD as pausas internas permanecem no sinal — condição que o
# diagnóstico de canal avalia separadamente.
#
#   SR_CONFIG=configs/brsd.env python experiments/run_experiment.py
##############################################################################

EXPERIMENT_NAME=brsd-referencia

# ---- Corpus ----------------------------------------------------------------
DATASET_FORMAT=brsd
AUDIO_PATH=/media/lsmsqt/HDD/datasets/brsd/utterances
NUM_SPEAKERS=80
NUM_UTTERANCES=5

# ---- Pré-processamento -----------------------------------------------------
SOURCE_SAMPLING_RATE=48000
TARGET_SAMPLING_RATE=8000
ENABLE_VAD=false
VAD_TOP_DB=30
PRE_EMPHASIS_COEF=0.97
NUM_MFCCS=40
# 256 amostras a 8 kHz = 32 ms por janela; salto de 128 = 50% de sobreposição.
FRAME_SIZE=256

# ---- Protocolo -------------------------------------------------------------
# 5 partições sobre 5 enunciados = leave-one-utterance-out. Como todos os
# locutores leram os mesmos 5 textos, cada partição retém um texto de todos
# eles, e o conteúdo linguístico do teste nunca aparece no treino.
NUM_FOLDS=5
VALIDATION_SEED=42
# -1 alinha pelo menor enunciado do corpus, sem corte arbitrário em 300 quadros.
MAX_FRAMES_CAP=-1

# ---- Treinamento -----------------------------------------------------------
ARCHITECTURES=cnn,temporal_cnn,attention
EPOCHS=1000
BATCH_SIZE=64
LEARNING_RATE=0.001
EARLY_STOPPING_PATIENCE=30

# ---- Saídas ----------------------------------------------------------------
FEATURES_PATH=/home/lsmsqt/Documents/sr/runs/features/brsd
MODELS_PATH=/home/lsmsqt/Documents/sr/runs/models/brsd
ENABLE_PLOTS=false
NUM_PLOT_EXAMPLES=4
