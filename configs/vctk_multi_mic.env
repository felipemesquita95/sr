##############################################################################
# VCTK — protocolo multi-microfone: treina com as duas trilhas.
#
# A partição é feita por enunciado, e as duas trilhas de um mesmo enunciado vão
# para o mesmo lado da divisão: a frase nunca aparece ao mesmo tempo em treino e
# teste. Como cada locutor é visto no treino através de dois canais distintos, a
# assinatura do microfone deixa de ser preditiva do rótulo.
#
# Comparar este resultado com o do protocolo cross-microfone indica se a
# exposição a múltiplos canais durante o treino de fato remove o atalho, ou se
# apenas o substitui por outro (a assinatura de sessão, comum às duas trilhas).
#
# Pré-requisito: features das duas trilhas já extraídas.
#
#   SR_CONFIG=configs/vctk_multi_mic.env python experiments/run_experiment.py
##############################################################################

EXPERIMENT_NAME=vctk-multi-mic

DATASET_FORMAT=vctk
VCTK_ROOT=/home/lsmsqt/datasets/vctk/VCTK-Corpus-0.92/wav48_silence_trimmed
VCTK_MIC=mic1
# Trilhas sobre cuja interseção a numeração é definida. p280 e p315 não
# possuem mic2; numerar cada trilha isoladamente deslocaria os locutores
# seguintes entre elas, e o índice deixaria de designar a mesma pessoa.
VCTK_MICS=mic1,mic2
NUM_SPEAKERS=110
NUM_UTTERANCES=200

BOTH_MICS=true
FEATURES_PATHS=/home/lsmsqt/Documents/sr/runs/features/vctk_mic1,/home/lsmsqt/Documents/sr/runs/features/vctk_mic2

SOURCE_SAMPLING_RATE=48000
TARGET_SAMPLING_RATE=16000
ENABLE_VAD=true
NUM_MFCCS=40
FRAME_SIZE=512
NUM_FOLDS=5
MAX_FRAMES_CAP=300

ARCHITECTURES=cnn,temporal_cnn,attention
EPOCHS=1000
BATCH_SIZE=64
LEARNING_RATE=0.001
EARLY_STOPPING_PATIENCE=30

FEATURES_PATH=/home/lsmsqt/Documents/sr/runs/features/vctk_mic1
MODELS_PATH=/home/lsmsqt/Documents/sr/runs/models/vctk_multi_mic
