##############################################################################
# VCTK — alinhado ao perfil de referência do BrSD: 8 kHz, janela de 256, sem
# detecção de atividade vocal.
#
# Existe porque comparar BrSD com VCTK sob parâmetros diferentes confunde o
# corpus com o pré-processamento. O perfil de referência do BrSD reproduz o
# experimento original e não é negociável; portanto é o VCTK que se alinha a
# ele, e não o contrário.
#
# Difere de configs/vctk.env em três pontos, e só neles: banda até 4 kHz em vez
# de 8 kHz, janela de 256 amostras (os mesmos 32 ms na nova taxa) e VAD
# desligado. A pré-ênfase permanece em 0,97, que é o valor do BrSD.
#
#   SR_CONFIG=configs/vctk8k.env python experiments/run_experiment.py
##############################################################################

EXPERIMENT_NAME=vctk8k-mic2

DATASET_FORMAT=vctk
VCTK_ROOT=/media/lsmsqt/HDD/datasets/vctk/VCTK-Corpus-0.92/wav48_silence_trimmed
VCTK_MIC=mic2
# Trilhas sobre cuja interseção a numeração é definida. p280 e p315 não
# possuem mic2; numerar cada trilha isoladamente deslocaria os locutores
# seguintes entre elas, e o índice deixaria de designar a mesma pessoa.
VCTK_MICS=mic1,mic2
NUM_SPEAKERS=108
NUM_UTTERANCES=200

# ---- Pré-processamento, idêntico a configs/brsd.env ------------------------
SOURCE_SAMPLING_RATE=48000
TARGET_SAMPLING_RATE=8000
ENABLE_VAD=false
VAD_TOP_DB=30
PRE_EMPHASIS_COEF=0.97
NUM_MFCCS=40
# 256 amostras a 8 kHz = 32 ms por janela; salto de 128 = 50% de sobreposição.
FRAME_SIZE=256

NUM_FOLDS=5
VALIDATION_SEED=42
# Mesma divisão 60/20/20 do mic1 para manter os pares alinhados.
VALIDATION_FOLD_OFFSET=1
# -1 alinha pelo menor enunciado; rebuild_8k.sh usa o menor entre os dois microfones.
MAX_FRAMES_CAP=-1

ARCHITECTURES=cnn,temporal_cnn,attention
EPOCHS=1000
BATCH_SIZE=64
LEARNING_RATE=0.001
EARLY_STOPPING_PATIENCE=30

FEATURES_PATH=/home/lsmsqt/Documents/sr/runs/features/vctk8k_mic2
MODELS_PATH=/home/lsmsqt/Documents/sr/runs/models/vctk8k_mic2
ENABLE_PLOTS=false
NUM_PLOT_EXAMPLES=4
