# Matriz pareada, prioridade 2 de docs/ideias.md. Executar SOMENTE com:
# KERAS_BACKEND=torch .venv/bin/python experiments/transfer_matrix.py
# Divisão e três sementes de treino fixadas no instrumento; não são folds.
# FEATURES_PATH_TRAIN identifica mic1; FEATURES_PATH_TEST identifica mic2.
EXPERIMENT_NAME=vctk-transfer-matrix
DATASET_FORMAT=vctk
VCTK_ROOT=/home/lsmsqt/datasets/vctk/VCTK-Corpus-0.92/wav48_silence_trimmed
VCTK_MICS=mic1,mic2
NUM_SPEAKERS=108
NUM_UTTERANCES=200
FEATURES_PATH_TRAIN=runs/features/vctk_mic1
FEATURES_PATH_TEST=runs/features/vctk_mic2
MODELS_PATH=runs/models/vctk_transfer_matrix
SOURCE_SAMPLING_RATE=48000
TARGET_SAMPLING_RATE=16000
ENABLE_VAD=true
NUM_MFCCS=40
FRAME_SIZE=512
MAX_FRAMES_CAP=300
ARCHITECTURES=cnn
EPOCHS=1000
BATCH_SIZE=64
LEARNING_RATE=0.001
EARLY_STOPPING_PATIENCE=30
