##############################################################################
# VCTK — protocolo cross-microfone: treina no mic1, avalia no mic2.
#
# Cada frase do VCTK foi captada simultaneamente por dois microfones. Voz, texto
# e instante são idênticos entre as trilhas; apenas o transdutor muda. Um modelo
# que tenha aprendido a assinatura espectral do microfone de treino não a
# encontra no de teste.
#
# A distância entre a acurácia dentro de um mesmo microfone e a acurácia obtida
# aqui mede diretamente quanto do desempenho aparente se devia ao canal.
#
# Pré-requisito: rodar antes configs/vctk.env e configs/vctk_mic2.env com
# --preprocess-only, para gerar as features das duas trilhas.
#
#   SR_CONFIG=configs/vctk_cross_mic.env python experiments/run_experiment.py
##############################################################################

EXPERIMENT_NAME=vctk-cross-mic

DATASET_FORMAT=vctk
VCTK_ROOT=/home/lsmsqt/datasets/vctk/VCTK-Corpus-0.92/wav48_silence_trimmed
VCTK_MIC=mic1
NUM_SPEAKERS=110
NUM_UTTERANCES=200

CROSS_MIC=true
FEATURES_PATH_TRAIN=/home/lsmsqt/Documents/sr/runs/features/vctk_mic1
FEATURES_PATH_TEST=/home/lsmsqt/Documents/sr/runs/features/vctk_mic2
CROSS_MIC_VALIDATION_PER_SPEAKER=10

SOURCE_SAMPLING_RATE=48000
TARGET_SAMPLING_RATE=16000
ENABLE_VAD=true
NUM_MFCCS=40
FRAME_SIZE=512
NUM_FOLDS=5
MAX_FRAMES_CAP=300

ARCHITECTURES=cnn,temporal_cnn,attention
EPOCHS=1000
BATCH_SIZE=64
LEARNING_RATE=0.001
EARLY_STOPPING_PATIENCE=30

FEATURES_PATH=/home/lsmsqt/Documents/sr/runs/features/vctk_mic1
MODELS_PATH=/home/lsmsqt/Documents/sr/runs/models/vctk_cross_mic
