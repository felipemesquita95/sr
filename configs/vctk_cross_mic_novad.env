##############################################################################
# VCTK — protocolo cross-microfone sobre as trilhas SEM detecção de voz.
#
# Existe para separar duas causas que o perfil com VAD mistura na mesma queda de
# acurácia:
#
#   1. o canal — o modelo aprendeu a assinatura espectral do microfone de treino
#      e não a encontra no de teste;
#   2. a dessincronia introduzida pelo próprio VAD — ele é aplicado a cada
#      trilha isoladamente, com limiar relativo ao pico daquele sinal, e como os
#      microfones diferem em nível e ruído de fundo os cortes caem em pontos
#      distintos. Medido em experiments/verify_alignment.py: apenas 212 de 6200
#      gravações mantêm a mesma duração entre as trilhas, com divergência
#      mediana de 11,5% e máxima de 69%.
#
# Sem VAD as duas trilhas voltam a ser quadro a quadro correspondentes, e a
# afirmação de que "apenas o transdutor muda" volta a ser estritamente
# verdadeira. A diferença entre este resultado e o do perfil com VAD é a parcela
# da queda atribuível à causa 2.
#
# MAX_FRAMES_CAP é mantido em 300, igual ao do perfil com VAD, e não elevado ao
# p95 desta variante (406). A escolha é deliberada: com o mesmo comprimento de
# entrada nos dois perfis, a única diferença entre eles é o VAD, e não também a
# dimensionalidade do tensor. O custo é que aqui se trunca bem mais sinal — o
# viés existe, favorece o perfil com VAD, e qualquer leitura da comparação
# precisa dizê-lo.
#
# Pré-requisito: as features de experiments/ingest_vctk.py --no-vad.
#
#   SR_CONFIG=configs/vctk_cross_mic_novad.env python experiments/run_experiment.py
##############################################################################

EXPERIMENT_NAME=vctk-cross-mic-sem-vad

DATASET_FORMAT=vctk
VCTK_ROOT=/home/lsmsqt/datasets/vctk/VCTK-Corpus-0.92/wav48_silence_trimmed
VCTK_MIC=mic1
# Trilhas sobre cuja interseção a numeração é definida. p280 e p315 não
# possuem mic2; numerar cada trilha isoladamente deslocaria os locutores
# seguintes entre elas, e o índice deixaria de designar a mesma pessoa.
VCTK_MICS=mic1,mic2
# 108, e não os 110 do corpus: p280 e p315 não possuem trilha mic2, e a
# numeração é definida sobre a interseção declarada em VCTK_MICS. Declarar 110
# criaria duas classes sem exemplo algum e faria o acaso ser reportado como
# 0,91% em vez dos 0,93% efetivos.
NUM_SPEAKERS=108
NUM_UTTERANCES=200

CROSS_MIC=true
FEATURES_PATH_TRAIN=/home/lsmsqt/Documents/sr/runs/features/vctknovad_mic1
FEATURES_PATH_TEST=/home/lsmsqt/Documents/sr/runs/features/vctknovad_mic2
CROSS_MIC_VALIDATION_PER_SPEAKER=10

SOURCE_SAMPLING_RATE=48000
TARGET_SAMPLING_RATE=16000
ENABLE_VAD=false
VAD_TOP_DB=30
PRE_EMPHASIS_COEF=0.97
NUM_MFCCS=40
FRAME_SIZE=512
NUM_FOLDS=5
MAX_FRAMES_CAP=300

ARCHITECTURES=cnn,temporal_cnn,attention
EPOCHS=1000
BATCH_SIZE=64
LEARNING_RATE=0.001
EARLY_STOPPING_PATIENCE=30

FEATURES_PATH=/home/lsmsqt/Documents/sr/runs/features/vctknovad_mic1
MODELS_PATH=/home/lsmsqt/Documents/sr/runs/models/vctk_cross_mic_novad
ENABLE_PLOTS=false
NUM_PLOT_EXAMPLES=0
