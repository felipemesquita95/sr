##############################################################################
# BrSD — variante com VAD e 16 kHz.
#
# Difere do perfil de referência em três parâmetros: banda até 8 kHz em lugar
# de 4 kHz, remoção dos trechos sem voz, e janela de 512 amostras (32 ms na
# nova taxa, preservando a duração da janela do perfil de referência).
#
#   SR_CONFIG=configs/brsd.env python experiments/run_experiment.py
##############################################################################

EXPERIMENT_NAME=brsd-vad-16k

# ---- Corpus ----------------------------------------------------------------
DATASET_FORMAT=brsd
AUDIO_PATH=/home/lsmsqt/datasets/brsd/utterances
NUM_SPEAKERS=80
NUM_UTTERANCES=5

# ---- Pré-processamento -----------------------------------------------------
SOURCE_SAMPLING_RATE=48000
TARGET_SAMPLING_RATE=16000
ENABLE_VAD=true
VAD_TOP_DB=30
PRE_EMPHASIS_COEF=0.97
NUM_MFCCS=40
# 512 amostras a 16 kHz = 32 ms, mesma duração de janela do perfil de referência.
FRAME_SIZE=512

# ---- Protocolo -------------------------------------------------------------
# 5 partições sobre 5 enunciados = leave-one-utterance-out. Como todos os
# locutores leram os mesmos 5 textos, cada partição retém um texto de todos
# eles, e o conteúdo linguístico do teste nunca aparece no treino.
NUM_FOLDS=5
VALIDATION_SEED=42

# ---- Treinamento -----------------------------------------------------------
ARCHITECTURES=cnn,temporal_cnn,attention
EPOCHS=1000
BATCH_SIZE=64
LEARNING_RATE=0.001
EARLY_STOPPING_PATIENCE=30

# ---- Saídas ----------------------------------------------------------------
FEATURES_PATH=/home/lsmsqt/Documents/sr/runs/features/brsd_vad
MODELS_PATH=/home/lsmsqt/Documents/sr/runs/models/brsd_vad
ENABLE_PLOTS=false
NUM_PLOT_EXAMPLES=4
