##############################################################################
# VCTK — perfil de referência, microfone 1.
#
# Requer o corpus VCTK 0.92 em VCTK_ROOT. Diferente do BrSD, todos os locutores
# foram gravados na mesma sala e com o mesmo equipamento, de modo que o modelo
# do microfone não distingue locutores. Isso remove um dos confundidores, mas
# não o de sessão: cada locutor foi gravado em uma sessão única, e o que for
# particular daquela sessão continua correlacionado ao rótulo.
#
#   SR_CONFIG=configs/vctk.env python experiments/run_experiment.py
##############################################################################

EXPERIMENT_NAME=vctk-mic1

DATASET_FORMAT=vctk
VCTK_ROOT=/home/lsmsqt/datasets/vctk/VCTK-Corpus-0.92/wav48_silence_trimmed
VCTK_MIC=mic1
# Trilhas sobre cuja interseção a numeração é definida. p280 e p315 não
# possuem mic2; numerar cada trilha isoladamente deslocaria os locutores
# seguintes entre elas, e o índice deixaria de designar a mesma pessoa.
VCTK_MICS=mic1,mic2
# 108, e não os 110 do corpus: p280 e p315 não possuem trilha mic2, e a
# numeração é definida sobre a interseção declarada em VCTK_MICS. Declarar 110
# criaria duas classes sem exemplo algum e faria o acaso ser reportado como
# 0,91% em vez dos 0,93% efetivos.
NUM_SPEAKERS=108
# 200 enunciados por locutor. O corpus completo (cerca de 400) excede a memória
# disponível nesta máquina durante a montagem dos tensores.
NUM_UTTERANCES=200

SOURCE_SAMPLING_RATE=48000
TARGET_SAMPLING_RATE=16000
ENABLE_VAD=true
VAD_TOP_DB=30
PRE_EMPHASIS_COEF=0.97
NUM_MFCCS=40
FRAME_SIZE=512

NUM_FOLDS=5
VALIDATION_SEED=42
# Teto de padding: cobre o percentil 95 da duração dos enunciados e evita que um
# enunciado atípico defina o comprimento de todo o tensor.
MAX_FRAMES_CAP=300

ARCHITECTURES=cnn,temporal_cnn,attention
EPOCHS=1000
BATCH_SIZE=64
LEARNING_RATE=0.001
EARLY_STOPPING_PATIENCE=30

FEATURES_PATH=/home/lsmsqt/Documents/sr/runs/features/vctk_mic1
MODELS_PATH=/home/lsmsqt/Documents/sr/runs/models/vctk_mic1
ENABLE_PLOTS=false
NUM_PLOT_EXAMPLES=4
